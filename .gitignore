# runtime state — app recreates these on boot
data/apps/
data/.locks/
data/prefs.json
# one server per data folder, and what moving data into a new release leaves behind
data/server.lock
data.before-move-*/
generated.before-move-*/
DATA-MOVED.txt
# the Burp build's app window profile: unsaved edits and cached client content (docs/adr/0003)
app-window-profile/
# the handler rotates into .log.1, .log.2 and so on
data/vulnreport-errors.log*

# generated output
generated/*
!generated/.gitkeep
tools/observatory/observatory.html
tools/observatory/.observatory-*.tmp

# release packaging output
/dist/

# agent tooling: CLAUDE.md and .claude/ are committed; only local state is ignored
CLAUDE.local.md
.claude/settings.local.json
.impeccable/
.graphifyignore
graphify-out/

# secrets and tool output
.env
.env.*
!.env.example
node_modules/
build/
output/

# customer reports used for local testing; these never belong in the repository
/*.docx

# python / macOS
.venv/
__pycache__/
*.pyc
.DS_Store

# runtime backup written next to any JSON the app rewrites
vuln_library.bak.json

# local master copy of the library; the app only reads resources/vuln_library.json
/vuln_library.json
