# runtime state — app recreates these on boot
data/apps/
data/.locks/
data/prefs.json
# the handler rotates into .log.1, .log.2 and so on
data/vulnreport-errors.log*

# generated output
generated/*
!generated/.gitkeep

# agent tooling — not needed on other devices
.claude/
.impeccable/
.graphifyignore
graphify-out/

# python / macOS
.venv/
__pycache__/
*.pyc
.DS_Store

# runtime backup written next to any JSON the app rewrites
vuln_library.bak.json
