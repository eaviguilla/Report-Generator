{
  // The test selector, scripts/relevant_tests.py, runs without asking, except with --full. Every
  // other terminal command, including a whole-suite run, still asks first, as VS Code does by default.
  // The test levels are described under "Running tests in this repo" in the contributor instructions.
  "chat.tools.terminal.autoApprove": {
    "/relevant_tests\\.py(?!.*--full)/": true
  }
}
